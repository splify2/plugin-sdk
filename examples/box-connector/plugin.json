{
  "schema": 1,
  "id": "box-connector",
  "version": "2.1.0",
  "type": "plugin",
  "name": "sing-box на ядре steer",
  "description": "podkop и forkop работают через ядро steer вместо sing-box",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/splify2/steer-box-connector",
  "compat": {
    "steer-api": "^1.4"
  },
  "arch": [
    "aarch64_cortex-a53",
    "aarch64_cortex-a72",
    "aarch64_generic",
    "arm_cortex-a7_neon-vfpv4",
    "arm_cortex-a9",
    "arm_cortex-a9_neon",
    "arm_cortex-a9_vfpv3-d16",
    "mipsel_24kc",
    "mips_24kc",
    "x86_64"
  ],
  "requires": {
    "system": [
      "steer-box-connector"
    ]
  },
  "permissions": [
    "net.admin",
    "http",
    "ctl",
    "system-packages",
    "fs:/usr/bin/sing-box",
    "fs:/etc/init.d/sing-box",
    "fs:/etc/config/sing-box",
    "fs:/etc/config/steer-box",
    "fs:/usr/libexec/rpcd/steer-box",
    "fs:/usr/share/rpcd/acl.d/luci-app-steer-box-connector.json",
    "fs:/usr/share/luci/menu.d/luci-app-steer-box-connector.json",
    "fs:/www/luci-static/resources/view/steer-box/main.js",
    "fs:/usr/share/nftables.d/chain-pre/forward/50-steer-box.nft"
  ],
  "steer": {
    "platform": {
      "mark_field": "0x000000ff",
      "rule_pref": 100,
      "mark_restore": true,
      "router_self": true
    },
    "links": [
      { "path": "/usr/bin/sing-box", "target": "bin/sing-box" },
      { "path": "/etc/init.d/sing-box", "target": "init/sing-box" },
      { "path": "/etc/config/sing-box", "target": "defaults/sing-box", "mode": "conf" },
      { "path": "/etc/config/steer-box", "target": "defaults/steer-box", "mode": "conf" },
      { "path": "/usr/libexec/rpcd/steer-box", "target": "luci/rpcd" },
      { "path": "/usr/share/rpcd/acl.d/luci-app-steer-box-connector.json", "target": "luci/acl.json" },
      { "path": "/usr/share/luci/menu.d/luci-app-steer-box-connector.json", "target": "luci/menu.json" },
      { "path": "/www/luci-static/resources/view/steer-box/main.js", "target": "luci/main.js" },
      { "path": "/usr/share/nftables.d/chain-pre/forward/50-steer-box.nft", "target": "fw4/50-steer-box.nft" }
    ]
  },
  "scripts": {
    "postinst": "scripts/postinst",
    "prerm": "scripts/prerm"
  },
  "i18n": {
    "languages": [
      "ru",
      "en"
    ]
  }
}
