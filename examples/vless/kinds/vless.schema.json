{
  "type": "object",
  "properties": {
    "subscription": { "type": "string", "minLength": 1, "x-path": "etc" },
    "node": { "type": "integer", "minimum": 1 },
    "nodes": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
    "transport": { "type": "array", "items": { "enum": ["tcp", "ws", "grpc", "xhttp", "httpupgrade"] }, "uniqueItems": true },
    "insecure": { "type": "boolean" },
    "exclude": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "exclude_name": { "type": "array", "items": { "type": "string" } },
    "only": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
    "active": { "type": "integer", "minimum": 1 },
    "by": { "enum": ["connection", "site", "site-client"] },
    "interval": { "type": "string", "pattern": "^[0-9]+[smh]$" },
    "silence": { "type": "string", "pattern": "^[0-9]+[smh]$" },
    "pick": { "enum": ["order", "latency"] },
    "tolerance": { "type": "integer", "minimum": 0, "maximum": 60000 }
  },
  "required": ["subscription"],
  "additionalProperties": false
}
