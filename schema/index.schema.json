{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splify2.github.io/plugin-sdk/schema/index.schema.json",
  "title": "Индекс репозитория плагинов (index.json), schema 1",
  "description": "Описание полей — docs/index.md. Индекс подписан: index.json.sig рядом (usign, роль index у официального репозитория).",
  "type": "object",
  "required": [
    "schema",
    "repo",
    "generated",
    "expires",
    "plugins"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "repo": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "description": "Имя пространства репозитория; у официального — splify2."
        },
        "name": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "Время сборки индекса (UTC). Менеджер не принимает индекс старее того, что уже видел из этого репозитория."
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "description": "После этого времени индекс не принимается: защита от подсовывания старого индекса."
    },
    "mirrors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "description": "Базовые адреса, к которым приклеиваются относительные path архивов. Перебор по порядку."
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "range": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plugin": {
      "type": "object",
      "required": [
        "name",
        "versions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "plugin",
            "library",
            "language",
            "theme"
          ],
          "default": "plugin"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "description": "Ставится при первой установке ядра (протоколы официального репозитория)."
        },
        "key_role": {
          "enum": [
            "protocols",
            "plugins"
          ],
          "description": "Только официальный репозиторий: каким ключом подписаны архивы этого плагина (В8). У стороннего — ключ репозитория."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": [
        "version",
        "compat",
        "assets"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "released": {
          "type": "string",
          "format": "date-time"
        },
        "compat": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/range"
          }
        },
        "requires": {
          "type": "object",
          "properties": {
            "plugins": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/range"
              }
            },
            "system": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kernel": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "provides": {
          "type": "object",
          "description": "Что эта версия регистрирует в ядре: для автоустановки по спеке и отказов «нужен плагин X».",
          "properties": {
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*(:[a-z0-9][a-z0-9-]*)?$"
              },
              "description": "Имена видов; «tunnel:vless» — протокол вида tunnel."
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "libs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "SONAME библиотек версии (type: library)."
            }
          },
          "additionalProperties": true
        },
        "changelog": {
          "type": "string"
        },
        "yanked": {
          "type": "object",
          "required": [
            "why"
          ],
          "properties": {
            "why": {
              "type": "string"
            },
            "security": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": true,
          "description": "Версия отозвана: не ставится; стоящую автообновление меняет первой."
        },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "description": "Ключ — архитектура OpenWrt или all.",
          "propertyNames": {
            "pattern": "^(all|[a-z0-9_]+(-[a-z0-9_]+)*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/asset"
          }
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "sha256",
        "size",
        "installed"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\x00]+\\.s2p$",
          "description": "Относительно каждого из mirrors."
        },
        "url": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "description": "Полные адреса, если архив лежит вне mirrors. Перебор по порядку."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Байт в .s2p"
        },
        "installed": {
          "type": "integer",
          "minimum": 0,
          "description": "Байт после распаковки (сумма размеров из MANIFEST)"
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "additionalProperties": true
    }
  }
}
