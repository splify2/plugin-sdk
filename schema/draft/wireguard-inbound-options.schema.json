{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT kernel WireGuard inbound options",
  "type": "object",
  "additionalProperties": false,
  "required": ["private_key", "listen_port", "addresses", "peers"],
  "properties": {
    "private_key": {"$ref": "#/$defs/secret"},
    "listen_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "mtu": {"type": "integer", "minimum": 1280, "maximum": 9000},
    "addresses": {"$ref": "#/$defs/prefixes"},
    "peers": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "public_key", "allowed_ips"],
      "properties": {
        "principal_id": {"$ref": "#/$defs/id"},
        "public_key": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"},
        "preshared_key": {"$ref": "#/$defs/secret"},
        "allowed_ips": {"$ref": "#/$defs/prefixes"}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}$"},
    "secret": {"type": "object", "additionalProperties": false, "required": ["secret"], "properties": {"secret": {"$ref": "#/$defs/id"}}},
    "prefixes": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 63, "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"}}
  }
}
