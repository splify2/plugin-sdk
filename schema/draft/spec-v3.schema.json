{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT Steer spec v3 minimum routing subset; no runtime support",
  "type": "object", "additionalProperties": false,
  "required": ["version", "plugin_remotes", "plugins", "inbounds", "outbounds", "routing"],
  "properties": {
    "version": {"const": 3},
    "plugin_remotes": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["url", "trust"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#@ ]+(/[^ #]*)?$"}, "trust": {"$ref": "#/$defs/name"}}}},
    "plugins": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["remote", "package", "version"], "properties": {"remote": {"$ref": "#/$defs/name"}, "package": {"$ref": "#/$defs/name"}, "version": {"type": "string", "minLength": 1}}}},
    "inbounds": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["plugin", "listen", "options"], "properties": {"plugin": {"$ref": "#/$defs/provider"}, "listen": {"type": "object", "additionalProperties": false, "required": ["address", "port"], "properties": {"address": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, "options": {"type": "object"}}}},
    "outbounds": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["plugin", "options"], "properties": {"plugin": {"$ref": "#/$defs/provider"}, "options": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["direct", "block"]}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "strategy", "members"], "properties": {"type": {"const": "group"}, "strategy": {"enum": ["order", "latency", "manual", "balance", "failover"]}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}}
    ]}},
    "routing": {"type": "object", "additionalProperties": false, "required": ["rules", "default"], "properties": {"default": {"$ref": "#/$defs/name"}, "rules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "match", "outbound"], "properties": {"name": {"$ref": "#/$defs/name"}, "outbound": {"$ref": "#/$defs/name"}, "match": {"type": "object", "additionalProperties": false, "required": ["inbound"], "properties": {"inbound": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}}}}}}}
  },
  "$defs": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}$"}, "provider": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}:[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}$"}}
}
