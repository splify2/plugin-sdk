{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts"]
}
