#!/usr/bin/env python3
"""Заглушка служб хоста splify2-api 1.0 (docs/splify2-api.md, раздел 8) для тестов совместимости.

Не копия каркаса, а стенд: те же команды, ответы и коды возврата, что у splify2-host, поверх каталога-песочницы
(S2_SANDBOX): спека-фикстура, каталог списков, сеть из фикстур, настройки плагина. Плагин видит только это.

    host fetch URL ФАЙЛ [--timeout СЕК]    host fetch-mode [get | set always|off]    host paths
    host spec get [ФАЙЛ] | uses ПУТЬ | check ФАЙЛ    host apply    host engine
    host settings get КЛЮЧ | set КЛЮЧ ЗНАЧЕНИЕ
    host state check|export|import КАТАЛОГ    host hook backup_sections --ctx ФАЙЛ [--plugin ID]
"""
import json, os, re, shutil, sys

W = os.environ.get("S2_SANDBOX", "")
if not W:
    print(json.dumps({"ok": False, "error": "заглушка хоста: нет песочницы"})); sys.exit(1)
LISTS = os.path.join(W, "lists")
SPEC = os.path.join(W, "spec.json")
WEB = os.path.join(W, "web")


def out(d, rc=0):
    print(json.dumps(d, ensure_ascii=False))
    sys.exit(rc)


def fail(msg, **kw):
    d = {"ok": False, "error": msg}
    d.update(kw)
    out(d, 1)


def usage():
    sys.stderr.write(__doc__)
    sys.exit(2)


def atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    open(tmp, "w", encoding="utf-8").write(text)
    os.replace(tmp, path)


def cmd_fetch(a):
    if len(a) < 2:
        usage()
    url, dest = a[0], a[1]
    if not re.match(r"^https?://", url):
        fail("ссылка должна начинаться с http:// или https://")
    # Сеть заглушки — файл web.json «ссылка → файл в web/»; чего там нет, того «не скачалось».
    try:
        table = json.load(open(os.path.join(WEB, "web.json"), encoding="utf-8"))
    except Exception:
        table = {}
    src = table.get(url)
    if not src:
        fail("не скачалось", note="заглушка хоста: адреса %s нет в фикстурах" % url)
    os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
    shutil.copyfile(os.path.join(WEB, src), dest + ".new")
    os.replace(dest + ".new", dest)
    out({"ok": True})


def cmd_fetch_mode(a):
    f = os.path.join(W, "fetch-mode")
    if not a or a[0] == "get":
        mode = open(f).read().strip() if os.path.exists(f) else "off"
        out({"mode": mode, "out": ""})
    if a[0] == "set" and len(a) > 1 and a[1] in ("always", "off"):
        atomic(f, a[1])
        out({"ok": True, "mode": a[1]})
    fail("режим бывает always или off")


def cmd_paths(a):
    os.makedirs(LISTS, exist_ok=True)
    out({"ok": True, "lists": LISTS, "steer": os.path.join(W, "steer")})


def cmd_spec(a):
    if not a:
        usage()
    if a[0] == "get":
        if not os.path.exists(SPEC):
            fail("спеки нет")
        if len(a) > 1:
            shutil.copyfile(SPEC, a[1])
            out({"ok": True})
        sys.stdout.write(open(SPEC, encoding="utf-8").read())
        sys.exit(0)
    if a[0] == "uses" and len(a) > 1:
        sys.exit(0 if os.path.exists(SPEC) and a[1] in open(SPEC, encoding="utf-8").read() else 1)
    if a[0] == "check" and len(a) > 1:
        try:
            json.load(open(a[1], encoding="utf-8"))
        except Exception:
            fail("ядро отвергло спеку: не JSON")
        out({"ok": True})
    usage()


def cmd_apply(a):
    print(json.dumps({"ok": True, "output": ""}))
    sys.exit(0)


def cmd_engine(a):
    out({"ok": True, "known": True, "enabled": True, "running": True})


def schema():
    pdir = os.environ.get("STEER_PLUGIN_DIR", "")
    conf = os.environ.get("STEER_PLUGIN_CONF", "")
    if not pdir or not conf:
        fail("служба для программ плагина: нет STEER_PLUGIN_DIR")
    try:
        rel = json.load(open(os.path.join(pdir, "plugin.json"), encoding="utf-8"))["splify2"]["settings"]["schema"]
        sch = json.load(open(os.path.join(pdir, rel), encoding="utf-8"))
    except Exception:
        fail("у плагина нет схемы настроек")
    return sch, os.path.join(conf, "settings.json")


def values(path):
    try:
        d = json.load(open(path, encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def cmd_settings(a):
    if len(a) < 2:
        usage()
    sch, path = schema()
    key = a[1]
    if not re.match(r"^[A-Za-z0-9_]+$", key):
        fail("имя настройки: латиница, цифры, подчёркивание")
    prop = sch.get("properties", {}).get(key)
    if prop is None:
        fail("в схеме нет настройки %s" % key)
    cur = values(path)
    if a[0] == "get":
        v = cur.get(key, prop.get("default"))
        if v is None:
            print("")
            sys.exit(1)
        print(("true" if v else "false") if isinstance(v, bool) else v)
        sys.exit(0)
    if a[0] != "set":
        usage()
    val = a[2] if len(a) > 2 else ""
    if val == "":
        cur.pop(key, None)
    else:
        t = prop.get("type")
        if t == "integer":
            if not re.match(r"^[0-9]+$", val):
                fail("%s: ждём целое число" % key)
            n = int(val)
            if "minimum" in prop and n < prop["minimum"]:
                fail("%s: не меньше %s" % (key, prop["minimum"]))
            if "maximum" in prop and n > prop["maximum"]:
                fail("%s: не больше %s" % (key, prop["maximum"]))
            new = n
        elif t == "boolean":
            if val not in ("true", "false"):
                fail("%s: ждём true или false" % key)
            new = val == "true"
        elif t == "string":
            new = val
        else:
            fail("%s: службой записываются строки, числа и флаги" % key)
        if "enum" in prop and val not in [str(x) for x in prop["enum"]]:
            fail("%s: значение не из списка допустимых" % key)
        if "pattern" in prop and not re.search(prop["pattern"], val):
            fail("%s: значение не подходит под шаблон" % key)
        cur[key] = new
    atomic(path, json.dumps(cur, ensure_ascii=False) + "\n")
    out({"ok": True})


STATE_FILES = re.compile(r"^(spec|sub|select|options|sub\.[A-Za-z0-9_]+|xsteer\.[A-Za-z0-9_.:@-]+)$")


def cmd_state(a):
    if len(a) < 2:
        usage()
    op, d = a[0], a[1]
    store = os.path.join(W, "core-state")
    if op == "export":
        os.makedirs(d, exist_ok=True)
        if os.path.isdir(store):
            for n in os.listdir(store):
                shutil.copyfile(os.path.join(store, n), os.path.join(d, n))
        out({"ok": True})
    if op in ("check", "import"):
        names = [n for n in os.listdir(d) if STATE_FILES.match(n)] if os.path.isdir(d) else []
        if not names:
            fail("в архиве нет ни настроек, ни списков")
        if op == "import":
            os.makedirs(store, exist_ok=True)
            for n in names:
                shutil.copyfile(os.path.join(d, n), os.path.join(store, n))
            out({"ok": True, "spec": "spec" in names, "sub": "sub" in names,
                 "subs": len([n for n in names if n.startswith("sub.")]),
                 "xsteer": len([n for n in names if n.startswith("xsteer.")]), "select": "select" in names})
        out({"ok": True})
    usage()


def cmd_hook(a):
    if not a or a[0] != "backup_sections":
        fail("хук %s хост программам плагинов не раздаёт" % (a[0] if a else ""))
    # В песочнице других плагинов нет: пустой список, как у хоста в безопасном режиме.
    out({"ok": True, "results": []})


CMDS = {"fetch": cmd_fetch, "fetch-mode": cmd_fetch_mode, "paths": cmd_paths, "spec": cmd_spec, "apply": cmd_apply,
        "engine": cmd_engine, "settings": cmd_settings, "state": cmd_state, "hook": cmd_hook}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        usage()
    CMDS[sys.argv[1]](sys.argv[2:])
